# Optional: custom streamlink command/path
STREAMLINK_COMMAND=streamlink

# Optional: ffmpeg command/path for low-latency decode
FFMPEG_COMMAND=ffmpeg

# 1=prefer ffmpeg low-latency pipeline, 0=disable and force OpenCV
PREFER_LOW_LATENCY=1

# run.sh only: 1=auto download project-local ffmpeg when missing
AUTO_DOWNLOAD_FFMPEG=1

# run.sh only: optional custom ffmpeg archive URL
# FFMPEG_DOWNLOAD_URL=
